{
  "expo": {
    "name": "ARIBA Employee",
    "slug": "ariba-employee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.ariba.employee",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لتسجيل الحضور داخل نطاق موقع العمل.",
        "NSFaceIDUsageDescription": "نستخدم Face ID لتسجيل دخولك بسرعة وأمان."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sa.ariba.employee",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-localization",
        {
          "forcesRTL": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحتاج موقعك لتسجيل الحضور داخل نطاق موقع العمل."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نستخدم Face ID لتسجيل دخولك بسرعة وأمان."
        }
      ]
    ],
    "scheme": "ariba",
    "experiments": {
      "typedRoutes": true
    }
  }
}
