# development | test | production
ENV=development

# SQLite locally. On Railway set DATABASE_URL=${{Postgres.DATABASE_URL}} (reference to the Postgres service).
DATABASE_URL=sqlite:///./dev.db
# Railway runs migrations in the pre-deploy step, so set this to false there.
RUN_MIGRATIONS_ON_STARTUP=true

# Signs session tokens. Required in production: a random string of 32+ characters.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=ariba-hr
JWT_AUDIENCE=ariba-hr-api
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Uploaded photos/documents. On Railway: the mount path of the Volume, e.g. /data
STORAGE_DIR=.storage

# The frontend's URL(s), comma-separated.
CORS_ORIGINS=http://localhost:3000

# Login throttling: per username and per client IP, in the configured window.
LOGIN_WINDOW_SECONDS=300
LOGIN_MAX_PER_USERNAME=5
LOGIN_MAX_PER_IP=20

# Maximum uploaded file size (12 MiB by default).
MAX_UPLOAD_BYTES=12582912

# First deploy only: creates this admin when there are no users yet. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: a Postgres database for the Postgres migration/RLS test.
# TEST_DATABASE_URL=postgresql://localhost/ariba_hr_test

# ---- Features ported from the React system (docs/17_PORT_PLAN.md) ----
# Key that encrypts the saved mailbox passwords (AES-GCM). Any long random string; keep it — changing it makes the saved
# passwords unreadable (re-enter them in the mail settings).
MAIL_SECRET_KEY=
# Fallback sender when no mailbox is saved or SMTP fails (Resend), and Microsoft 365 through Graph (optional).
RESEND_API_KEY=
EMAIL_FROM=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# 1 = never send e-mail / app push (test and demo environments).
MAIL_DISABLED=0
PUSH_DISABLED=0
# Background jobs (escalation hourly, e-mail + push every 5 minutes, automatic candidates every minute). 0 = off.
SCHEDULER_ENABLED=1
# Fingerprint / Face ID sign-in on the site: the site's host name and full origin(s). Default: the first CORS origin.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
